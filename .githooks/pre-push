#!/bin/sh
# Oberste Regel: keine persönlichen Daten in Dateien (CLAUDE.md).
# Prüft jeden Commit, der gleich das Gerät verlässt.
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$(git rev-list --max-parents=0 "$local_sha" | tail -n 1)..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  node scripts/privacy-guard.mjs --range "$range" || exit 1
done
